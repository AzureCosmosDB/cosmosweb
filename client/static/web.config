<?xml version="1.0" encoding="utf-8"?>
<!--
  Docusaurus copies everything in static/ to the site root, so this file ships with every deploy.

  The site moved from developer.azurecosmosdb.com to cosmosdb.microsoft.com. Everything still requested on the
  old hostname gets a permanent (301) redirect, so old links, bookmarks and search results (Google, Bing) never
  dead-end:

    - a URL that is still a page or file on this site keeps its path and query string on the new hostname;
    - any other URL (pages that were retired, old hashed CSS/JS files, old image folders) goes to the homepage.

  Only the old hostname matches: the staging and v2 slots and the azurewebsites.net address are served as before.
  Certificate validation (/.well-known/) is left alone so the old hostname's certificate keeps renewing.

  To send every old URL to the homepage instead, delete the first two rules.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          {REQUEST_URI} keeps the query string exactly as sent. IIS decodes the path before rules run, which does
          not matter here because every URL on this site is a plain path (no spaces or encoded slashes).
        -->
        <rule name="Old hostname: existing file to same path" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^developer\.azurecosmosdb\.com(:\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="https://cosmosdb.microsoft.com{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <rule name="Old hostname: existing page to same path" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^developer\.azurecosmosdb\.com(:\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="https://cosmosdb.microsoft.com{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <rule name="Old hostname: anything else to homepage" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^developer\.azurecosmosdb\.com(:\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://cosmosdb.microsoft.com/" redirectType="Permanent" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
